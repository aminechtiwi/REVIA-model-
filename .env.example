# ============================================================
# REVIA — Environment Variables Template
# Copy this file to .env and fill in your keys:
# cp .env.example .env
# ============================================================

# --- LLM API Keys (Free Options Available) ---
# Groq (Free & Blazing Fast Llama 3.3 70B): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (Free tier with Vision): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (Free models backup): https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Z.AI (Zhipu GLM) (Optional)
ZAI_API_KEY=your_zai_api_key_here

# Anthropic Claude (Optional): https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Optional): https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Deepgram (AI Streaming STT & Neural Turn-Taking): https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- Google APIs (Gmail + Calendar) ---
# Create credentials at: https://console.cloud.google.com
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json

# --- Web Search (optional, DuckDuckGo is used for free by default) ---
SERPAPI_KEY=

# --- REVIA Behavior ---
REVIA_NAME=REVIA
REVIA_DEFAULT_LANGUAGE=auto       # auto / arabic / french / english
REVIA_REQUIRE_PERMISSION=true     # Always ask before acting on PC
